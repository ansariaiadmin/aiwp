# ============================================
# AiWp Platform — .env.example — جادوگر v3.0.0 — پشتیبانی صفر — Zero Support
# توضیح فارسی برای هر متغیر — فقط ضروری‌ها — بقیه خودکار
# کپی: cp .env.example .env — بعد: ./install.sh — جادوگر همه چی رو می‌پرسه با راهنما همون‌جا
# ============================================

# --- دیتابیس — Database — خودکار — جادوگر می‌سازه ---
# چیه؟ جایی که اطلاعات ذخیره می‌شه — مثل انبار
DATABASE_URL=postgresql://aiwp:aiwp@localhost:5432/aiwp
POSTGRES_USER=aiwp
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=aiwp

# --- ردیس — Redis — کش — خودکار ---
REDIS_URL=redis://localhost:6379/0

# --- امنیت — Security — خودکار — جادوگر رمز بانکی 32 کاراکتری می‌سازه ---
# چیه؟ رمزهای امنیتی — مثل رمز بانکی — جادوگر خودش می‌سازه
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-openssl-rand-base64-32
ENCRYPTION_KEY=change-me-32-byte-base64

# --- AI Provider — پرووایدر هوش مصنوعی — با راهنما همون‌جا ---
# چیه؟ شرکتی که هوش مصنوعی می‌ده — برای ساخت افزونه
# گزینه‌ها: openai (GPT-4), anthropic (Claude), google (Gemini), openrouter (هر مدل), mock (بدون AI واقعی — برای تست)
# کجا بگیرم؟ https://platform.openai.com/api-keys → Create key → sk-proj-...
# مثال: sk-proj-abc123...
AI_PROVIDER=mock
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...

# --- SMS Panel — پنل پیامکی — با راهنما همون‌جا ---
# چیه؟ سرویسی که پیامک می‌فرسته — برای کد تایید، لایسنس، ناتیف
# گزینه‌ها: ghasedak (قاصدک — ایرانی، ارزون — https://ghasedak.me/), kavenegar (کاوه‌نگار — https://kavenegar.com/), melipayamak, mock (بدون پیامک واقعی — تو لاگ)
# کجا بگیرم؟ https://ghasedak.me/ → ثبت‌نام → داشبورد → API Key — رایگان 50 پیامک
# شماره فرستنده: مثل 10008566 — از پنل → شماره‌ها
SMS_PROVIDER=mock
SMS_API_KEY=ghasedak-key
SMS_SENDER=10008566
GHASEDAK_API_KEY=ghasedak-key
KAVENEGAR_API_KEY=kavenegar-key

# --- Email — ایمیل — با راهنما همون‌جا ---
# چیه؟ برای ارسال ایمیل تایید، فاکتور
# گزینه‌ها: smtp (Gmail یا هاست خودت), resend (https://resend.com/ — مدرن — رایگان 3000/ماه), mock (بدون ایمیل واقعی — تو لاگ)
# Gmail: myaccount.google.com → Security → App Passwords → 16 کاراکتر
EMAIL_PROVIDER=mock
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=pass
RESEND_API_KEY=re_...
EMAIL_FROM=AiWp Platform <no-reply@aiwp.local>
APP_URL=http://localhost:3000

# --- Notification System — سیستم ناتیفیکیشن — سقف 10/10 — جدید v3.0.0 ---
# چیه؟ اطلاع‌رسانی — وقتی اتفاقی می‌افته (ثبت‌نام، پرداخت، خطا) خبر می‌ده
# کانال‌ها: in_app (داخل برنامه — همیشه روشن), email (ایمیل), sms (پیامک), telegram (ربات تلگرام — برای ادمین)
# چطور کار می‌کنه؟ جادوگر می‌پرسه: "ایمیل ناتیف روشن باشه؟" → از همون SMTP استفاده می‌کنه
# تلگرام: @BotFather → /newbot → توکن → https://api.telegram.org/bot<TOKEN>/getUpdates → chat_id
NOTIF_IN_APP=true
NOTIF_EMAIL=false
NOTIF_SMS=false
NOTIF_TELEGRAM=false
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# --- وردپرس — WordPress — برای تست افزونه‌ها ---
WP_SITE_URL=http://localhost:8080
WP_ADMIN_USER=admin
WP_ADMIN_PASS=admin123
PLATFORM_PORT=3000
LOG_LEVEL=info
HOSTNAME=0.0.0.0
