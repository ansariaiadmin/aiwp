# AiWp Platform environment template.
# Copy to .env:  cp .env.example .env
# install.sh replaces the change-me placeholders automatically; if you set up
# manually, generate real values with:  openssl rand -base64 48
#
# Only variables actually read by the code are listed here
# (platform/src/lib/env.ts validates the required ones at boot).

# ── Required (app exits at boot without them) ────────────────────────────────
DATABASE_URL=postgresql://aiwp:aiwp@localhost:5432/aiwp
SESSION_SECRET=change-me-openssl-rand-base64-48
ENCRYPTION_KEY=change-me-openssl-rand-base64-32

# ── Optional ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
APP_URL=http://localhost:3000
NODE_ENV=production
LOG_LEVEL=info
HOSTNAME=0.0.0.0
TRUST_PROXY=1
DATABASE_POOL_MAX=10
DATABASE_USE_PREPARED_STATEMENTS=true
ALLOWED_ORIGINS=

# Transactional email via Resend (leave unset to log emails instead of sending)
RESEND_API_KEY=
EMAIL_FROM=AiWp Platform <no-reply@aiwp.local>
