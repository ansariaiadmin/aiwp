# AnsariAiWP Platform — environment template
# Only variables the code actually reads (see platform/src/lib/env.ts and
# grep -r "process.env." platform/src). install.sh copies this file to .env
# and auto-fills SESSION_SECRET / ENCRYPTION_KEY with random values.

# ── Required (app refuses to boot without them) ─────────────────────────
DATABASE_URL=postgresql://aiwp:aiwp@localhost:5432/aiwp
SESSION_SECRET=change-me-session-secret-32-chars-minimum
ENCRYPTION_KEY=change-me-encryption-key-16-chars-minimum

# ── Optional ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
DATABASE_POOL_MAX=10
DATABASE_USE_PREPARED_STATEMENTS=true
EMAIL_FROM="AnsariAiWP <no-reply@ansariai.ir>"
RESEND_API_KEY=
LOG_LEVEL=info
