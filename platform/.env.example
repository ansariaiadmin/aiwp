# AiWp Platform — environment configuration.
#
# Copy this file to `.env` (local development) or `.env.production`
# (docker-compose.prod.yml) and fill in real values. NEVER commit the
# filled-in file — .gitignore already excludes .env* except this example.

# --- Database ---------------------------------------------------------
# Full Postgres connection string. In docker-compose.prod.yml this is
# assembled automatically from POSTGRES_* below; set it directly for local
# development against your own Postgres instance.
DATABASE_URL="postgresql://aiwp:aiwp@localhost:5432/aiwp"

# Used by docker-compose.prod.yml to configure the bundled Postgres
# container. Pick a strong, random password — this is a real secret.
POSTGRES_USER=aiwp
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
POSTGRES_DB=aiwp

# Advanced: connection pool size and prepared-statement behavior. Defaults
# are correct for real Postgres. Only change DATABASE_USE_PREPARED_STATEMENTS
# to "true" when connecting directly to Postgres (no PgBouncer in
# transaction-pooling mode in front of it).
# DATABASE_POOL_MAX=10
# DATABASE_USE_PREPARED_STATEMENTS=false

# --- Redis (optional, recommended for multi-instance deployments) -----
# When set, rate limiting is shared across all app instances via Redis
# instead of falling back to a per-instance in-memory counter.
REDIS_URL="redis://:change-me@localhost:6379"
REDIS_PASSWORD=change-me

# --- Secrets (REQUIRED, generate with `openssl rand -base64 48`) ------
# Signs session JWTs. Must be at least 32 characters. Rotating this value
# invalidates every existing session.
SESSION_SECRET="replace-with-a-real-random-secret-at-least-32-characters"

# Encrypts platform settings at rest (AI provider API key, SMS gateway
# credentials) with AES-256-GCM. Must be at least 16 characters. Losing
# this key makes existing encrypted settings unrecoverable by design —
# back it up somewhere safe (a secrets manager, not this file).
ENCRYPTION_KEY="replace-with-a-real-random-secret-at-least-16-characters"

# --- App -----------------------------------------------------------------
NODE_ENV=production
APP_URL="https://your-domain.example.com"
LOG_LEVEL=info

# --- Email (optional; without it, verification/reset emails are logged
# instead of sent — fine for local development, not for production) -----
RESEND_API_KEY=
EMAIL_FROM="AiWp Platform <no-reply@your-domain.example.com>"

# --- Nginx / TLS (docker-compose.prod.yml + nginx/conf.d) ----------------
DOMAIN=your-domain.example.com
